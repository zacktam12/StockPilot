generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(uuid()) @db.VarChar(36)
  email               String    @unique
  password            String
  firstName           String?
  lastName            String?
  phone               String?
  profilePicture      String?
  isAdmin             Boolean   @default(false)
  status              UserStatus @default(Active)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  roleId              String    @db.VarChar(36)
  deactivatedAt       DateTime?
  deactivatedBy       String?
  employeeId          String?    @unique
  resetToken          String?   @db.VarChar(255)
  resetTokenExpiry    DateTime?
  failedLoginAttempts Int       @default(0)
  lockUntil           DateTime?
  lastLoginAttempt    DateTime? @default(now())

  // Relations
  salesAsSeller    Sale[]     @relation("SalesToSeller")
  purchasesAsBuyer Purchase[] @relation("PurchasesToBuyer")
  role             Role       @relation(fields: [roleId], references: [id])
  notifications    Notification[]

  // Inverse relations for Supplier
  createdSuppliers    Supplier[] @relation("CreatedSuppliers")
  deletedSuppliers    Supplier[] @relation("DeletedSuppliers")
}

enum UserStatus {
  Active
  Inactive
  Deactivated
  Banned
}

model Role {
  id         String    @id @default(uuid()) @db.VarChar(36)
  role_type  String    @unique
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  createdBy  String?
  deletedBy  String?
  isDeleted  Boolean   @default(false)

  users      User[]
}

model Category {
  id              String    @id @default(uuid()) @db.VarChar(36)
  name            String    @unique
  description     String?
  slug            String?   @unique
  parentId        String?   @db.VarChar(36)
  icon            String?
  color           String?
  sortOrder       Int       @default(0)
  isActive        Boolean   @default(true)
  isVisible       Boolean   @default(true)
  metaTitle       String?
  metaDescription String?
  tags            String?   @db.Text
  image           String?
  customFields    Json?
  isDeleted       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  products        Product[]
  parent          Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryHierarchy")
}

model Product {
  id             String    @id @default(uuid()) @db.VarChar(36)
  name           String
  description    String?
  sku            String?   @unique
  barcode        String?   @unique
  price          Float
  cost           Float?
  quantity       Int       @default(0)
  minStock       Int?
  maxStock       Int?
  image          String?
  isDeleted      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  categoryId     String?   @db.VarChar(36)

  category       Category? @relation(fields: [categoryId], references: [id])
  productSales   ProductSale[]
  productPurchases ProductPurchase[]
}

model Customer {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String
  email     String?  @unique
  phone     String?
  address   String?
  createdAt DateTime @default(now())

  sales     Sale[]
}

model Sale {
  id            String    @id @default(uuid()) @db.VarChar(36)
  userId        String    @db.VarChar(36)
  customerId    String?   @db.VarChar(36)
  orderNumber   String?   @unique
  totalPrice    Float
  discount      Float?    @default(0)
  tax           Float?    @default(0)
  paymentMethod String?
  status        String?   @default("completed")
  notes         String?
  isDeleted     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation("SalesToSeller", fields: [userId], references: [id])
  customer      Customer? @relation(fields: [customerId], references: [id])
  productSales  ProductSale[]
}

model Purchase {
  id                String    @id @default(uuid()) @db.VarChar(36)
  poNumber          String? @unique @db.VarChar(20)
  userId            String    @db.VarChar(36)
  supplierId        String    @db.VarChar(36)
  totalCost         Float
  discount          Float?    @default(0)
  tax               Float?    @default(0)
  status            String?   @default("received")
  notes             String?
  isDeleted         Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation("PurchasesToBuyer", fields: [userId], references: [id])
  supplier          Supplier  @relation(fields: [supplierId], references: [id])
  productPurchases  ProductPurchase[]
}

model ProductSale {
  id           String    @id @default(uuid()) @db.VarChar(36)
  productId    String    @db.VarChar(36)
  saleId       String    @db.VarChar(36)
  sale_quantity Int
  sale_price   Float
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  createdBy    String?
  deletedBy    String?
  isDeleted    Boolean   @default(false)

  product      Product   @relation(fields: [productId], references: [id])
  sale         Sale      @relation(fields: [saleId], references: [id])
}

model ProductPurchase {
  id                String    @id @default(uuid()) @db.VarChar(36)
  productId         String    @db.VarChar(36)
  purchaseId        String    @db.VarChar(36)
  purchase_price    Float
  purchase_quantity Int
  createdAt         DateTime  @default(now())
  deletedAt         DateTime?
  createdBy         String?
  deletedBy         String?
  isDeleted         Boolean   @default(false)

  product           Product   @relation(fields: [productId], references: [id])
  purchase          Purchase  @relation(fields: [purchaseId], references: [id])
}

model Supplier {
  id          String    @id @default(uuid()) @db.VarChar(36)
  name        String
  contactName String?
  email       String?   @unique
  phone       String?
  address     String?
  companyName String?
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.VarChar(36)
  deletedAt   DateTime?
  deletedById String?   @db.VarChar(36)

  // Relations
  createdBy   User?     @relation("CreatedSuppliers", fields: [createdById], references: [id])
  deletedBy   User?     @relation("DeletedSuppliers", fields: [deletedById], references: [id])
  purchases   Purchase[]
}

model Settings {
  id                String   @id @default(uuid()) @db.VarChar(36)
  appName           String   @default("StockPilot")
  theme             String   @default("light")
  lowStockThreshold Int      @default(5)
  currency          String   @default("USD")
  taxRate           Float    @default(0)
  lowStockAlerts    Boolean  @default(true)
  salesReports      Boolean  @default(true)
  newCustomerAlerts Boolean  @default(false)
  systemUpdates     Boolean  @default(true)
  passwordExpiry    Int      @default(90)
  sessionTimeout    Int      @default(30)
  loginAttempts     Int      @default(5)
  
  // Company Information
  companyName       String?
  companyEmail      String?
  companyPhone      String?
  companyAddress    String?
  companyTaxId      String?
  companyLogo       String?
  companyWebsite    String?
  
  // Additional Settings
  emailNotifications Boolean @default(true)
  orderConfirmations Boolean @default(true)
  twoFactorAuth      Boolean @default(false)
  autoBackup         Boolean @default(false)
  backupFrequency    String  @default("daily")
  timezone           String  @default("UTC")
  dateFormat         String  @default("MM/DD/YYYY")
  timeFormat         String  @default("12")
  language           String  @default("en")
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Notification {
  id          String           @id @default(uuid()) @db.VarChar(36)
  userId      String           @db.VarChar(36)
  type        NotificationType
  title       String
  message     String
  read        Boolean          @default(false)
  data        Json?            // Additional data like order numbers, amounts, etc.
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id])
}

enum NotificationType {
  LOW_STOCK
  PURCHASE
  SALE
  CUSTOMER
  USER
  SUPPLIER
  CATEGORY
  SYSTEM
}