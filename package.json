{
  "name": "stockpilot",
  "version": "2.5.0",
  "description": "Modern Inventory Management System",
  "main": "start-all.js",
  "scripts": {
    "start": "node start-all.js",
    "dev": "node start-all.js",
    "install-all": "npm install && cd backend && npm install && cd ../frontend && npm install && cd ../LandingPage && npm install",
    "build-all": "cd backend && npm run build && cd ../frontend && npm run build && cd ../LandingPage && npm run build",
    "backend": "cd backend && npm run dev",
    "frontend": "cd frontend && npm run dev",
    "landing": "cd LandingPage && npm run dev"
  },
  "keywords": [
    "inventory",
    "management",
    "stock",
    "react",
    "nodejs",
    "nextjs"
  ],
  "author": "StockPilot Team",
